{ pkgs, ... }:

let
  terminal = "alacritty";
  fileManager = "thunar";
  # Walker replaces rofi's drun mode. With walker.nix's runAsService = true,
  # a background instance is already running (like Wayle's bar), so this
  # is just activating it rather than a cold start each time.
  menu = "walker";

  # hyprexpo ($mod+Tab-hold via bind below) zooms out to a grid of every
  # workspace at once. Dropped from the official hyprwm/hyprland-plugins
  # monorepo a while back (it now only ships borders-plus-plus,
  # csgo-vulkan-fix, hyprbars, hyprfocus — see that repo's README), so this
  # pulls the actively-maintained community fork instead. Its tags track
  # Hyprland's own versioning (v0.56.2 here matches pkgs.hyprland exactly),
  # so bump the rev/hash together with nixpkgs' hyprland bump if the plugin
  # ever fails to load (`journalctl --user -b | grep -i plugin`).
  hyprexpo = pkgs.hyprlandPlugins.mkHyprlandPlugin {
    pluginName = "hyprexpo";
    version = "0.56.2";
    src = pkgs.fetchFromGitHub {
      owner = "sandwichfarm";
      repo = "hyprexpo";
      rev = "v0.56.2";
      hash = "sha256-wTCuGWvlodB0W6W3Zesth2lKIQe2QEhKMu4VEYBsxPE=";
    };
    nativeBuildInputs = [ pkgs.cmake ];
    meta = {
      homepage = "https://github.com/sandwichfarm/hyprexpo";
      description = "Enhanced Hyprland workspaces overview plugin";
      license = pkgs.lib.licenses.bsd3;
    };
  };
in
{
  wayland.windowManager.hyprland = {
    enable = true;
    xwayland.enable = true;

    configType = "hyprlang";

    # borders-plus-plus (hyprwm/hyprland-plugins): real second solid-color
    # outline ring around windows — Hyprland's built-in shadow can't render
    # hard-edged, so this plugin is the only way to get one.
    #
    # Must come from the same nixpkgs input as the `hyprland` package
    # itself, or it hits the "Failed to load the following plugin" runtime
    # error (hyprwm/hyprland-plugins#193). This flake already pins that; if
    # it ever fails to load after a rebuild, check
    # `journalctl --user -b | grep -i plugin`.
    plugins = [
      pkgs.hyprlandPlugins.borders-plus-plus
      hyprexpo
    ];

    settings = {
      "$mod" = "SUPER";
      "$terminal" = terminal;
      "$fileManager" = fileManager;
      "$menu" = menu;

      # Single display, auto-negotiated resolution/refresh rate/position.
      # Replace with e.g. "DP-1,2560x1440@144,0x0,1" once you know your
      # exact monitor name (`hyprctl monitors` after first boot into Hyprland).
      monitor = ",preferred,auto,1";

      exec-once = [
        # Live shaderbg background (wallpaper-shader.nix) replaces hyprpaper
        # for the desktop — running both would fight over the background
        # layer. hyprpaper.nix stays enabled since hyprlock reads
        # wp_cloud.jpg directly, not through hyprpaper.
        "wallpaper-shader"
        "hypridle"
        "copyq" # clipboard manager backend + tray icon; $mod+C toggles its window (clipboard.nix)
        # No exec-once for the status bar — Wayle (wayle.nix) ships its own
        # systemd user service that autostarts on the Wayland session target.
        "blueman-applet" # tray icon; Hyprland doesn't autostart XDG entries on its own
        "workspace1-showcase" # fastfetch + perlin-art + btop grid on workspace 1, see windowrule block below
        "sleep 1 && hyprctl dismissnotify"
      ];

      env = [
        "NIXOS_OZONE_WL,1" # Wayland-native Electron/Chromium apps
        "TZDIR,/etc/zoneinfo"
      ];

      input = {
        kb_layout = "us";
        follow_mouse = 1;
        sensitivity = 0;
        touchpad = {
          natural_scroll = true;
        };
      };

      # Colors are deliberately NOT set here — col.active_border,
      # col.inactive_border, decoration.shadow.color, and
      # misc.background_color all come from the `source`d
      # ~/.cache/theme/hypr-colors.conf instead, regenerated by
      # `apply-theme` (wallpaper-shader.nix) whenever the theme changes.
      general = {
        gaps_in = 4;
        gaps_out = 8;
        border_size = 2;
        layout = "dwindle";
        resize_on_border = true;
        allow_tearing = false;
      };

      decoration = {
        rounding = 0; # square — no rounded corners anywhere
        active_opacity = 1.0;
        inactive_opacity = 0.8;

        # Turned OFF: the "two outlines" look now comes from the
        # borders-plus-plus plugin (see the `plugins =` line above) instead
        # of a fake-sharpened shadow — with that plugin active, keeping a
        # soft diffuse shadow underneath as well would just look like
        # clutter around the new solid ring. Flip `enabled` back to `true`
        # (and drop the plugin) any time you want a normal soft shadow
        # instead — `range`/`render_power` below are normal, unhacked
        # values for that case.
        shadow = {
          enabled = false;
          range = 20;
          render_power = 3;
        };

        blur = {
          enabled = true;
          size = 6;
          passes = 2;
          new_optimizations = true;
          ignore_opacity = true;
        };
      };

      # Second border ring, drawn by the borders-plus-plus plugin. This has
      # to be a TOP-LEVEL `plugin { }` section (Hyprland reads plugin config
      # as `plugin:borders-plus-plus:...`, not nested under `decoration`) —
      # it was accidentally nested inside `decoration` above before, which
      # is exactly the "config option <decoration:plugin:borders-plus-plus:
      # add_borders> does not exist" error. `add_borders = 1` = exactly one
      # extra ring outside the real border. `border_size_1` is its thickness
      # in px. `natural_rounding = false` keeps it square, matching
      # `rounding = 0` above. `col.border_1` is deliberately NOT set here —
      # it comes from the sourced hypr-colors.conf (bg color), same pattern
      # as col.active_border, so it recolors on every `apply-theme` call —
      # see wallpaper-shader.nix's write_hypr_colors().
      plugin = {
        "borders-plus-plus" = {
          add_borders = 1;
          border_size_1 = 1;
          natural_rounding = false;
        };

        # hyprexpo ($mod+grave bind below) — grid overview of all
        # workspaces. `bg_col`/`border_color_current` are deliberately NOT
        # set here — they come from the sourced hypr-colors.conf
        # (background/accent), same pattern as borders-plus-plus's
        # col.border_1 above, so they recolor on every `apply-theme` call.
        # keynav_enable/cancel_key default to on/escape, so arrow keys +
        # enter + escape already work inside the overview with no extra
        # submap needed.
        #
        # Deliberately NOT setting gesture_fingers/gesture_direction here —
        # hyprexpo registers that gesture at plugin-init time, which
        # occasionally races against Hyprland's own startup sequencing on a
        # cold login and throws a config error ("invalid value ... for
        # finger count" / "invalid direction"). The keybind below doesn't
        # have this problem since it's a lazy dispatcher call, not a
        # device-level hook registered at boot.
        hyprexpo = {
          columns = 3;
          gaps_in = 8;
          gaps_out = 8;
          workspace_method = "first 1";
        };
      };

      animations = {
        enabled = true;
        bezier = [
          "easeOutQuint,0.23,1,0.32,1"
        ];
        # Lower = faster in Hyprland's animation speed units.
        animation = [
          "windows, 1, 2, easeOutQuint"
          "windowsIn, 1, 2, easeOutQuint, popin 87%"
          "windowsOut, 1, 2, easeOutQuint, popin 87%"
          "fade, 1, 2, default"
          "workspaces, 1, 2, easeOutQuint, slide"
          "border, 1, 3, default"
        ];
      };

      misc = {
        disable_hyprland_logo = true;
        disable_splash_rendering = true;
        middle_click_paste = false;
      };

      source = [ "~/.cache/theme/hypr-colors.conf" ];

      dwindle = {
        # pseudotile = true;
        preserve_split = true;
      };

      gesture = [
        "3, horizontal, workspace"
      ];

      # --- Keybindings -------------------------------------------------
      bind = [
        "$mod, RETURN, exec, $terminal"
        "$mod, Q, killactive,"
        "$mod SHIFT, M, exit,"
        "$mod, E, exec, $fileManager"
        "$mod, V, togglefloating,"
        "$mod, R, exec, walker"
        # copyq toggle shows/hides CopyQ's own GUI list (with real image
        # thumbnails, unlike a Walker dmenu) — see clipboard.nix.
        "$mod, C, exec, copyq toggle"
        "$mod, P, pseudo,"
        "$mod, J, layoutmsg, togglesplit"
        "$mod, F, fullscreen,"
        "$mod SHIFT, L, exec, hyprlock"

        # hyprexpo — grid overview of every workspace
        "$mod, grave, hyprexpo:expo, toggle"

        # alt+tab cycles windows on the current workspace (shift = reverse);
        # bringactivetotop is paired in so a cycled-to floating window
        # actually raises above others, not just gains focus underneath.
        "ALT, Tab, cyclenext,"
        "ALT, Tab, bringactivetotop,"
        "ALT SHIFT, Tab, cyclenext, prev"
        "ALT SHIFT, Tab, bringactivetotop,"

        # hyper+tab cycles workspaces (shift = reverse), skipping empty ones
        "$mod, Tab, workspace, e+1"
        "$mod SHIFT, Tab, workspace, e-1"

        # focus movement
        "$mod, left, movefocus, l"
        "$mod, right, movefocus, r"
        "$mod, up, movefocus, u"
        "$mod, down, movefocus, d"

        # window movement
        "$mod SHIFT, left, movewindow, l"
        "$mod SHIFT, right, movewindow, r"
        "$mod SHIFT, up, movewindow, u"
        "$mod SHIFT, down, movewindow, d"

        # screenshots (region -> clipboard, full screen -> file + clipboard)
        ", Print, exec, snip"
        "SHIFT, Print, exec, grim - | tee ~/Pictures/screenshot-$(date +%s).png | wl-copy"
        "$mod SHIFT, S, exec, snip"
      ]
      ++ (
        # $mod + [1-9,0] -> switch workspace, $mod SHIFT + [1-9,0] -> move window to workspace
        builtins.concatLists (
          builtins.genList (
            i:
            let
              ws = if i == 9 then "10" else toString (i + 1);
            in
            [
              "$mod, ${if i == 9 then "0" else ws}, workspace, ${ws}"
              "$mod SHIFT, ${if i == 9 then "0" else ws}, movetoworkspace, ${ws}"
            ]
          ) 10
        )
      );

      # bindr = release-triggered — needed so tapping $mod alone only fires
      # this when it's *not* part of another combo (e.g. $mod+Q).
      # Key name is case-sensitive (XKB keysym) — "Super_L", not "SUPER_L".
      bindr = [
        # walker.nix runs it as a long-lived background service
        # (runAsService = true), so this activates the existing instance
        # rather than pkill/cold-starting it.
        "$mod, Super_L, exec, walker"
      ];

      bindm = [
        "$mod, mouse:272, movewindow"
        "$mod, mouse:273, resizewindow"
      ];

      binde = [
        # media / volume (wpctl talks to the pipewire/wireplumber stack)
        ", XF86AudioRaiseVolume, exec, wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+"
        ", XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
        ", XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
        ", XF86MonBrightnessUp, exec, brightnessctl set 5%+"
        ", XF86MonBrightnessDown, exec, brightnessctl set 5%-"
      ];

      windowrule = [
        {
          name = "float-pavucontrol";
          float = true;
          "match:class" = "^(pavucontrol)$";
        }
        {
          name = "float-nmconnection";
          float = true;
          "match:class" = "^(nm-connection-editor)$";
        }
        {
          name = "float-vitality";
          float = true;
          "match:title" = "^(vitality)$";
        }
        {
          name = "float-pip";
          float = true;
          "match:title" = "^(Picture-in-Picture)$";
        }
        {
          name = "pin-pip";
          pin = true;
          "match:title" = "^(Picture-in-Picture)$";
        }

        # CopyQ ($mod+C / clipboard.nix) — float instead of tiling, so it
        # pops up over whatever you're working in rather than re-laying-out
        # the workspace. Alternation covers both its XWayland class ("copyq")
        # and Wayland-native reverse-DNS app id.
        {
          name = "float-copyq";
          float = true;
          "match:class" = "^([Cc]opy[Qq]|com\\.github\\.hluk\\.copyq)$";
        }

        # --- Workspace 1 showcase --------------------------------------
        # Real (non-floating) dwindle tiles. workspace1-showcase (in
        # scripts.nix) builds the actual grid geometry itself via
        # `layoutmsg preselect` + `layoutmsg splitratio <delta>` right
        # after each window opens — these rules just make sure all four
        # land on workspace 1 no matter which workspace was active when
        # the script runs (e.g. if you re-trigger it by hand later).
        {
          name = "showcase-fastfetch-ws";
          "match:class" = "^(showcase-fastfetch)$";
          workspace = "1";
        }
        {
          name = "showcase-perlin-ws";
          "match:class" = "^(showcase-perlin)$";
          workspace = "1";
        }
        {
          name = "showcase-perlin2-ws";
          "match:class" = "^(showcase-perlin2)$";
          workspace = "1";
        }
        {
          name = "showcase-btop-ws";
          "match:class" = "^(showcase-btop)$";
          workspace = "1";
        }
      ];
    };
  };

  home.packages = with pkgs; [
    brightnessctl
    playerctl
  ];
}
