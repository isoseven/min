{ ... }:

{
  programs.hyprlock = {
    enable = true;
    settings = {
      # Hoisted to the top of the generated config (Home Manager's
      # `sourceFirst`) since hyprlang resolves `$variables` top-to-bottom.
      # Regenerated by `apply-theme` (wallpaper-shader.nix's
      # write_hyprlock_colors()) — no rebuild needed to pick up a new
      # theme's colors, only for structural changes to this file itself.
      source = [ "~/.cache/theme/hyprlock-colors.conf" ];

      general = {
        disable_loading_bar = true;
        hide_cursor = true;
        grace = 2;
      };

      # `path = "screenshot"` (grab whatever's on screen at lock time) was
      # tried and reverted — hiding open windows from it required hopping to
      # a special workspace right before locking, which broke normal window
      # interaction on workspace 2 afterward. Flat solid color instead:
      # `lock-bg.png` is a tiny hand-encoded PNG filled with the active
      # theme's exact background color, regenerated by `apply-theme`
      # (wallpaper-shader.nix's write_solid_png()). blur_passes/blur_size
      # are no-ops against a flat color; left in for if this goes back to a
      # real image later.
      background = [
        {
          path = "~/.cache/theme/lock-bg.png";
          blur_passes = 2;
          blur_size = 7;
          color = "$bgColor";
        }
      ];

      # Dead center — no offset. The old "0, -40" existed to leave room for
      # the clock/date sitting just below it; both moved to the top now, so
      # there's nothing left to make room for.
      input-field = [
        {
          size = "300, 60";
          position = "0, 0";
          halign = "center";
          valign = "center";
          rounding = 0; # square corners, matching decoration.rounding = 0 in hyprland.nix
          outline_thickness = 3;
          dots_size = 0.25;
          outer_color = "$accentColor";
          inner_color = "$surfaceColor";
          font_color = "$textColor";
          font_family = "Iosevka SKYC";
          fade_on_empty = false;
          placeholder_text = "Password...";
        }
      ];

      # Two labels (date, then a bigger clock under it), both anchored to
      # the top. Font size is a fixed pixel value — hyprlock labels don't
      # support vw/relative units.
      #
      # For valign = top, positive Y moves an element further away from the
      # screen (off the top edge entirely); negative Y moves it down into
      # the visible area. -48/-110 puts margin below the top edge, date
      # (smaller offset) above the clock (larger offset).
      label = [
        {
          text = "cmd[update:1000] echo \"$(date +'%A, %B %d')\"";
          font_size = 20;
          font_family = "Iosevka SKYC";
          position = "0, -48";
          halign = "center";
          valign = "top";
          color = "$textMutedColor";
        }
        {
          text = "cmd[update:1000] echo \"$(date +'%H:%M')\"";
          font_size = 64;
          font_family = "Iosevka SKYC";
          position = "0, -110";
          halign = "center";
          valign = "top";
          color = "$textColor";
        }
      ];
    };
  };
}
