{ config, ... }:

{
  programs.alacritty = {
    enable = true;
    settings = {
      #
      # Regenerated by `apply-theme` (wallpaper-shader.nix's
      # write_alacritty_colors()) from whichever Monkeytype theme is
      # active — replaces catppuccin.alacritty.enable now that catppuccin
      # is gone. `general.import` is alacritty's own real config-merging
      # mechanism (same idea as every other `source`d/`@import`ed theme
      # file in this repo). Alacritty live-reloads its own config file on
      # change, but that's not guaranteed to extend to files brought in
      # via `import` — if colors don't update instantly after
      # `apply-theme`, a restart picks them up for sure.


      # `apply-theme` imports the generated alacritty colors.
      general.import = [ "${config.home.homeDirectory}/.cache/theme/alacritty-colors.toml" ];

      env = {
        TERM = "xterm-256color";
      };

      window = {
        padding = {
          x = 10;
          y = 10;
        };
        opacity = 0.95;
        decorations = "none";
      };

      font = {
        normal = {
          family = "Iosevka SKYC";
          style = "Regular";
        };
        bold.style = "Bold";
        italic.style = "Italic";
        size = 11;
      };

      cursor.style = {
        shape = "Beam";
        blinking = "On";
      };

      scrolling.history = 10000;

      mouse.bindings = [
        {
          mouse = "Middle";
          action = "None";
        }
      ];
    };
  };
}
